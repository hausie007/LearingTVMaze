# Godot 4+ specific ignores
.godot/
/android/

# Build artifacts
*.apk
*.aab


# macOS
.DS_Store

# Studio Voice — generated audio and build reports.
# The masters are large, reproducible from the ledger, and must never reach the
# AAB; the .gdignore files stop Godot importing or exporting either folder and
# are the only thing kept from them.
/voice_masters/*
!/voice_masters/.gdignore
# The ledger is the exception: plain text, a few megabytes, and the record of
# every recording ever paid for. It is what makes "nothing was lost" a
# checkable claim rather than a reassurance, so it belongs in history even
# though the audio beside it does not.
!/voice_masters/generation_ledger.jsonl
/build/*
!/build/.gdignore

# Python bytecode from the tools/ scripts
__pycache__/
*.pyc
