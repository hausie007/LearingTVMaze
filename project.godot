; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bludiste"
config/description="Educational maze game for toddlers"
run/main_scene="res://scenes/splash.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0.082, 0.102, 0.137, 1)
boot_splash/use_filter=false
boot_splash/image="res://images/lm_paper_logo.png"
config/icon="res://images/android-icons/android_project_icon_1024.png"
config/android_tv_banner="res://images/lm_paper_logo.png"

[autoload]

TTS="*res://scripts/tts_manager.gd"
Config="*res://scripts/game_config.gd"
DPad="*res://scripts/virtual_dpad.gd"
NetworkManager="*res://scripts/network/network_manager.gd"
IdleManager="*res://scripts/idle_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/release_version_export/plugin.cfg")

[gui]

theme/custom="res://ui/default_theme.tres"

[input]

ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194308,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://data/translations.en.translation", "res://data/translations.cs.translation", "res://data/translations.de.translation", "res://data/translations.es.translation", "res://data/translations.fr.translation", "res://data/translations.pt.translation", "res://data/translations.vi.translation", "res://data/translations.tr.translation", "res://data/translations.it.translation", "res://data/translations.pl.translation", "res://data/translations.sv.translation", "res://data/translations.nb.translation", "res://data/translations.nl.translation", "res://data/translations.uk.translation", "res://data/translations.fi.translation", "res://data/translations.da.translation", "res://data/translations.hu.translation", "res://data/translations.ro.translation", "res://data/translations.el.translation", "res://data/translations.sk.translation", "res://data/translations.he.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
text/canvas_item_default_antialiasing=1
